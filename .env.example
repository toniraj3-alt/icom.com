# Complaint Portal: username can be ANY non-empty value.
# Configure up to 10 allowed passwords. Use your own secret numbers before deployment.
COMPLAINT_PASSWORD_1=CHANGE_ME_01
COMPLAINT_PASSWORD_2=CHANGE_ME_02
COMPLAINT_PASSWORD_3=CHANGE_ME_03
COMPLAINT_PASSWORD_4=CHANGE_ME_04
COMPLAINT_PASSWORD_5=CHANGE_ME_05
COMPLAINT_PASSWORD_6=CHANGE_ME_06
COMPLAINT_PASSWORD_7=CHANGE_ME_07
COMPLAINT_PASSWORD_8=CHANGE_ME_08
COMPLAINT_PASSWORD_9=CHANGE_ME_09
COMPLAINT_PASSWORD_10=CHANGE_ME_10

# SMTP settings for complaint email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
MAIL_FROM=your-email@example.com
